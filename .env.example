# Copy this file to .env.local for local development.
# Do not commit real secrets, tokens, database URLs, or WeChat credentials.

# Local development can use docker-compose Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/health_tracker?schema=public"

# Optional fallback used by db:doctor and local smoke checks when the pooled URL is unavailable.
DATABASE_URL_UNPOOLED=""

# Use a long random value in real environments.
SESSION_SECRET="replace-with-a-long-random-string"

# Optional: enables real email delivery for verification and password reset flows.
EMAIL_FROM="noreply@example.com"
RESEND_API_KEY="re_xxx"

# WeChat mini program alpha credentials.
# APP_ID must match miniprogram/project.config.json and should look like wx...
# APP_SECRET comes from the WeChat public platform secret field; it must not equal APP_ID.
WECHAT_MINI_PROGRAM_APP_ID="wx_xxx"
WECHAT_MINI_PROGRAM_APP_SECRET="wechat_secret_xxx"

# Keep false for Experience builds and production.
WECHAT_MINI_PROGRAM_MOCK_LOGIN_ENABLED="false"
