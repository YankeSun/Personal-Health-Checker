.summary {
  padding: 34rpx;
}

.eyebrow {
  color: #8a6a2d;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.title {
  display: block;
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 900;
}

.form {
  margin-top: 28rpx;
  padding: 34rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-row {
  display: flex;
  gap: 20rpx;
}

.half {
  flex: 1;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #6f675d;
  font-size: 24rpx;
  font-weight: 700;
}

.input {
  min-height: 92rpx;
  border-radius: 24rpx;
  background: #f8f4ec;
  padding: 0 24rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
}

.context-group {
  margin-top: 28rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.save-button {
  margin-top: 42rpx;
}

.success,
.error {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.success {
  color: #047857;
}

.error {
  color: #be123c;
}
