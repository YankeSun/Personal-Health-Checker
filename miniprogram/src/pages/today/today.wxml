<view class="page today-page">
  <view class="hero-card card">
    <view class="hero-topline">
      <text class="eyebrow">TODAY</text>
      <view class="date-control">
        <text class="date-mode">记录日期</text>
        <picker mode="date" value="{{selectedDate}}" start="{{minRecordDate}}" end="{{maxRecordDate}}" bindchange="handleDateChange">
          <view class="date-label date-picker {{selectedDate !== todayDate ? 'date-label-backfill' : ''}}">
            <text>{{dateDisplayLabel}}</text>
            <text class="date-picker-action">{{dateActionLabel}}</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="weight-focus">
      <text class="focus-label">{{recordFocusLabel}}</text>
      <text class="focus-value">{{weightDisplay}}</text>
      <text class="focus-hint">{{weightHint}}</text>
    </view>

    <view class="completion-panel">
      <view class="completion-meta">
        <text class="completion-title">已完成 {{completedCount}}/3</text>
        <text class="completion-next">{{nextStepText}}</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{completionPercent}}%;"></view>
      </view>
      <view class="step-list">
        <text
          wx:for="{{completionSteps}}"
          wx:key="key"
          class="step-pill {{item.done ? 'step-pill-done' : ''}}"
        >
          {{item.done ? "已记" : "待记"}} {{item.label}}
        </text>
      </view>
    </view>
  </view>

  <view class="record-card card">
    <view class="section-head">
      <text class="section-title">核心记录</text>
      <text class="section-note">体重优先，睡眠和饮水辅助回看节奏。</text>
    </view>

    <view class="field weight-field">
      <text class="label">体重 {{weightUnitLabel}}</text>
      <input class="input weight-input" type="digit" value="{{form.weightKg}}" placeholder="{{weightPlaceholder}}" data-field="weightKg" bindinput="handleInput" />
    </view>

    <view class="field-row">
      <view class="field half">
        <text class="label">睡眠 小时</text>
        <input class="input" type="digit" value="{{form.sleepHours}}" placeholder="7.5" data-field="sleepHours" bindinput="handleInput" />
      </view>
      <view class="field half">
        <text class="label">饮水 {{waterUnitLabel}}</text>
        <input class="input" type="number" value="{{form.waterMl}}" placeholder="{{waterPlaceholder}}" data-field="waterMl" bindinput="handleInput" />
      </view>
    </view>
  </view>

  <view wx:if="{{qualityWarnings.length > 0}}" class="warning-card card">
    <text class="warning-kicker">请确认</text>
    <view wx:for="{{qualityWarnings}}" wx:key="id" class="warning-item">
      <text class="warning-title">{{item.title}}</text>
      <text class="warning-copy">{{item.description}}</text>
    </view>
  </view>

  <view class="context-card card">
    <view class="section-head">
      <text class="section-title">体重背景</text>
      <text class="section-note">只选今天最影响判断的线索。</text>
    </view>

    <view class="context-group">
      <text class="context-label">饮食状态</text>
      <view class="chips">
        <text wx:for="{{dietOptions}}" wx:key="value" class="chip {{item.active ? 'chip-active' : ''}}" data-value="{{item.value}}" bindtap="toggleDiet">
          {{item.label}}
        </text>
      </view>
    </view>

    <view class="context-grid">
      <view class="context-group compact">
        <text class="context-label">活动量</text>
        <view class="chips">
          <text wx:for="{{activityOptions}}" wx:key="value" class="chip {{item.active ? 'chip-active' : ''}}" data-value="{{item.value}}" data-field="activityLevel" bindtap="toggleSingleContext">
            {{item.label}}
          </text>
        </view>
      </view>

      <view class="context-group compact">
        <text class="context-label">精神状态</text>
        <view class="chips">
          <text wx:for="{{energyOptions}}" wx:key="value" class="chip {{item.active ? 'chip-active' : ''}}" data-value="{{item.value}}" data-field="energyLevel" bindtap="toggleSingleContext">
            {{item.label}}
          </text>
        </view>
      </view>
    </view>

    <view class="context-group">
      <text class="context-label">称重时段</text>
      <view class="chips">
        <text wx:for="{{timingOptions}}" wx:key="value" class="chip {{item.active ? 'chip-active' : ''}}" data-value="{{item.value}}" data-field="weighTiming" bindtap="toggleSingleContext">
          {{item.label}}
        </text>
      </view>
    </view>
  </view>

  <view class="submit-card card">
    <button class="primary-button save-button" loading="{{saving || loadingRecord}}" bindtap="saveRecord">{{saveButtonLabel}}</button>
    <view wx:if="{{message}}" class="save-feedback">
      <text class="success">{{message}}</text>
      <button class="ghost-button dashboard-button" bindtap="goDashboard">看今日概览</button>
    </view>
    <view wx:if="{{error}}" class="error-card">
      <text class="error">{{error}}</text>
      <text wx:if="{{errorDetail}}" class="error-detail">{{errorDetail}}</text>
      <button wx:if="{{errorRetryLabel}}" class="ghost-button retry-button" bindtap="retryLastAction">{{errorRetryLabel}}</button>
    </view>
  </view>
</view>
