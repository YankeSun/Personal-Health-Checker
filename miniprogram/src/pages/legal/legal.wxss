.legal-card,
.section-card {
  padding: 34rpx;
}

.section-card {
  margin-top: 24rpx;
}

.eyebrow {
  color: #8a6a2d;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.title {
  display: block;
  margin-top: 18rpx;
  color: #172033;
  font-size: 44rpx;
  font-weight: 900;
}

.summary,
.updated {
  display: block;
  margin-top: 18rpx;
  color: #777064;
  font-size: 26rpx;
  line-height: 1.65;
}

.updated {
  font-size: 24rpx;
}

.item-list {
  display: grid;
  gap: 16rpx;
  margin-top: 22rpx;
}

.legal-item {
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 24rpx;
  background: rgba(248, 250, 252, 0.82);
  padding: 22rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1.65;
}
