<view class="page trends-page">
  <view class="hero card">
    <view class="hero-topline">
      <text class="eyebrow">WEIGHT LINE</text>
      <text class="date-label">最近 {{trend.days || 30}} 天</text>
    </view>
    <text class="hero-value">{{trend.latestDisplay || "--"}} {{trend.unitLabel || "kg"}}</text>
    <text class="hero-subtitle">体重线 · {{trend.recordedDays || 0}}/{{trend.days || 30}} 天</text>
  </view>

  <view class="insight-card card {{insight.toneClass}}">
    <text class="insight-kicker">这条线在说</text>
    <text class="insight-title">{{insight.title}}</text>
    <text class="insight-copy">{{insight.description}}</text>
  </view>

  <view class="card spark-card">
    <view class="section-head">
      <text class="section-title">体重线</text>
      <text class="section-note">留白就是缺口</text>
    </view>
    <view class="spark-chart">
      <view wx:for="{{sparkPoints}}" wx:key="date" class="spark-column">
        <view class="spark-rail">
          <view class="spark-bar {{item.barClass}}" style="height: {{item.heightPercent}}%;"></view>
        </view>
        <text class="spark-label">{{item.label}}</text>
      </view>
    </view>
    <view class="spark-legend">
      <text class="legend-item">实心 当天</text>
      <text class="legend-item">浅色 补录 / 缺口</text>
    </view>
  </view>

  <view class="grid">
    <view class="stat card">
      <text class="label">均值</text>
      <text class="metric-value">{{trend.averageDisplay || "--"}}</text>
      <text class="stat-note">这一段</text>
    </view>
    <view class="stat card">
      <text class="label">区间</text>
      <text class="range-value">{{trend.minDisplay || "--"}} - {{trend.maxDisplay || "--"}}</text>
      <text class="stat-note">{{trend.unitLabel || "kg"}}</text>
    </view>
  </view>

  <view class="card comparison-card">
    <text class="section-title">{{comparison.title}}</text>
    <text class="comparison-value {{comparison.directionClass}}">{{comparison.value}}</text>
    <text class="context-copy">{{comparison.description}}</text>
  </view>

  <view wx:if="{{contextSummary}}" class="card context-card">
    <view class="section-head">
      <text class="section-title">体重线索</text>
      <text class="section-note">{{contextSummary.taggedDays || 0}} 天有线索</text>
    </view>
    <text class="context-title">{{contextSummary.title}}</text>
    <text class="context-copy">{{contextSummary.description}}</text>
    <view wx:if="{{contextSummary.topContextLabels.length > 0}}" class="chips">
      <text wx:for="{{contextSummary.topContextLabels}}" wx:key="label" class="chip">
        {{item.label}} {{item.count}} 次
      </text>
    </view>
  </view>

  <view class="action-card card" data-route="{{trendAction.route}}" bindtap="handleTrendAction">
    <text class="action-title">{{trendAction.title}}</text>
    <text class="action-copy">{{trendAction.description}}</text>
    <text class="action-link">{{trendAction.label}}</text>
  </view>

  <view class="card block">
    <text class="section-title">最近落点</text>
    <view wx:for="{{recentPoints}}" wx:key="date" class="point-row">
      <view>
        <text class="point-date">{{item.label}}</text>
        <text class="point-source {{item.sourceClass}}">{{item.sourceLabel}}</text>
      </view>
      <text class="point-value">{{item.valueLabel}}</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error-card">
    <text class="error">{{error}}</text>
    <text wx:if="{{errorDetail}}" class="error-detail">{{errorDetail}}</text>
    <button wx:if="{{errorRetryLabel}}" class="ghost-button retry-button" bindtap="retryLastAction">{{errorRetryLabel}}</button>
  </view>
</view>
