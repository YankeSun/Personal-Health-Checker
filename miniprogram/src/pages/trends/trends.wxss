.trends-page {
  padding-bottom: 48rpx;
}

.hero {
  overflow: hidden;
  padding: 34rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(247, 200, 111, 0.34), transparent 34%),
    linear-gradient(145deg, #172033 0%, #26372f 58%, #805f2c 100%);
  color: #fffaf0;
}

.hero-topline,
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.eyebrow {
  color: rgba(255, 250, 240, 0.72);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.date-label {
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  color: rgba(255, 250, 240, 0.78);
  font-size: 22rpx;
}

.hero-value {
  display: block;
  margin-top: 36rpx;
  font-size: 76rpx;
  font-weight: 950;
  letter-spacing: -2rpx;
}

.hero-subtitle {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 250, 240, 0.78);
  font-size: 26rpx;
}

.insight-card,
.spark-card,
.comparison-card,
.context-card,
.action-card,
.block {
  margin-top: 24rpx;
  padding: 30rpx;
}

.insight-card {
  background: #fff8e8;
}

.tone-warning {
  border-color: rgba(180, 83, 9, 0.24);
}

.tone-success {
  border-color: rgba(4, 120, 87, 0.22);
}

.tone-info {
  border-color: rgba(23, 32, 51, 0.1);
}

.insight-kicker {
  display: block;
  color: #8a6a2d;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.insight-title,
.action-title,
.context-title {
  display: block;
  color: #172033;
  font-weight: 950;
  line-height: 1.3;
}

.insight-title {
  margin-top: 12rpx;
  font-size: 34rpx;
}

.insight-copy,
.context-copy,
.action-copy,
.stat-note,
.section-note {
  display: block;
  color: #777064;
  font-size: 24rpx;
  line-height: 1.55;
}

.insight-copy,
.context-copy,
.action-copy {
  margin-top: 10rpx;
}

.section-title {
  font-size: 30rpx;
}

.spark-chart {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 260rpx;
  margin-top: 28rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(23, 32, 51, 0.04), rgba(23, 32, 51, 0.01)),
    #f8f4ec;
  padding: 24rpx 18rpx 16rpx;
}

.spark-column {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.spark-rail {
  display: flex;
  align-items: flex-end;
  width: 100%;
  height: 196rpx;
}

.spark-bar {
  width: 100%;
  min-height: 12rpx;
  border-radius: 999rpx 999rpx 12rpx 12rpx;
}

.spark-bar-recorded {
  background: #172033;
}

.spark-bar-backfilled {
  background: #c9b99d;
}

.spark-bar-empty {
  background: rgba(23, 32, 51, 0.12);
}

.spark-label {
  display: block;
  margin-top: 10rpx;
  color: #8a8175;
  font-size: 18rpx;
}

.spark-legend {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
}

.legend-item {
  color: #777064;
  font-size: 22rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.stat {
  padding: 30rpx;
}

.label {
  color: #6f675d;
  font-size: 24rpx;
  font-weight: 800;
}

.metric-value,
.range-value {
  display: block;
  margin-top: 8rpx;
  color: #172033;
  font-weight: 950;
}

.metric-value {
  font-size: 52rpx;
}

.range-value {
  font-size: 30rpx;
}

.comparison-value {
  display: block;
  margin-top: 14rpx;
  font-size: 46rpx;
  font-weight: 950;
}

.delta-down,
.delta-flat {
  color: #047857;
}

.delta-up {
  color: #9a5412;
}

.delta-none {
  color: #6f675d;
}

.context-title {
  margin-top: 22rpx;
  font-size: 30rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.action-card {
  background: #172033;
  color: #fffaf0;
}

.action-title {
  color: #fffaf0;
  font-size: 32rpx;
}

.action-copy {
  color: rgba(255, 250, 240, 0.74);
}

.action-link {
  display: inline-block;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: #f7c86f;
  padding: 12rpx 20rpx;
  color: #172033;
  font-size: 24rpx;
  font-weight: 900;
}

.point-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
  padding: 22rpx 0;
}

.point-date {
  display: block;
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.point-source {
  display: inline-block;
  margin-top: 8rpx;
  border-radius: 999rpx;
  padding: 5rpx 10rpx;
  font-size: 20rpx;
  font-weight: 900;
}

.source-current {
  background: #ecfdf5;
  color: #047857;
}

.source-backfilled {
  background: #f8f4ec;
  color: #6f675d;
}

.point-value {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.error {
  display: block;
  margin-top: 20rpx;
  color: #be123c;
  font-size: 26rpx;
}
