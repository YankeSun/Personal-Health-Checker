<view class="page login-page">
  <view class="hero card">
    <text class="eyebrow">PERSONAL HEALTH CHECKER</text>
    <text class="title">把今天，记下来</text>
    <text class="subtitle">体重、睡眠、饮水。轻轻记下，慢慢看见。</text>

    <view class="agreement" bindtap="toggleLegalAccepted">
      <text class="check {{acceptedLegal ? 'check-active' : ''}}">{{acceptedLegal ? "✓" : ""}}</text>
      <text class="agreement-copy">我已阅读并同意隐私保护指引和用户协议，并了解本产品不提供医疗诊断。</text>
    </view>

    <button class="primary-button login-button" loading="{{loading}}" bindtap="handleWechatLogin">
      微信登录，开始记录
    </button>
    <button wx:if="{{mockLoginEnabled}}" class="ghost-button mock-login-button" loading="{{mockLoading}}" bindtap="handleMockLogin">
      体验登录
    </button>

    <text class="privacy">仅用于个人记录和趋势回看，不提供医疗诊断或治疗建议。</text>
    <view class="legal-links">
      <text data-type="privacy" bindtap="openLegal">隐私保护指引</text>
      <text data-type="terms" bindtap="openLegal">用户协议</text>
      <text data-type="health" bindtap="openLegal">健康免责声明</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error-card">
    <text class="error-title">{{error}}</text>
    <text wx:if="{{errorDetail}}" class="error-detail">{{errorDetail}}</text>
  </view>
</view>
