<view class="page login-page">
  <view class="hero card">
    <text class="eyebrow">PERSONAL HEALTH CHECKER</text>
    <text class="title">把今天的体重管理记录下来</text>
    <text class="subtitle">先从体重、睡眠、饮水和几个日常背景开始，形成可回看的轻量记录。</text>

    <button class="primary-button login-button" loading="{{loading}}" bindtap="handleWechatLogin">
      微信登录并开始记录
    </button>

    <text class="privacy">仅用于个人记录和趋势回看，不提供医疗诊断、治疗建议或设备同步。</text>
  </view>

  <view wx:if="{{error}}" class="error-card">{{error}}</view>
</view>
