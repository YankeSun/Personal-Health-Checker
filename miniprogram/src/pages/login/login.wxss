.login-page {
  display: flex;
  align-items: center;
}

.hero {
  width: 100%;
  padding: 48rpx 40rpx;
}

.eyebrow {
  color: #8a6a2d;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.title {
  display: block;
  margin-top: 28rpx;
  color: #172033;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.12;
}

.subtitle {
  display: block;
  margin-top: 24rpx;
  color: #6b6459;
  font-size: 28rpx;
  line-height: 1.7;
}

.login-button {
  margin-top: 48rpx;
}

.agreement {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  border-radius: 28rpx;
  background: rgba(248, 250, 252, 0.8);
  padding: 22rpx;
}

.check {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.check-active {
  border-color: #172033;
  background: #172033;
}

.agreement-copy {
  color: #5e574d;
  font-size: 24rpx;
  line-height: 1.6;
}

.privacy {
  display: block;
  margin-top: 28rpx;
  color: #8b8376;
  font-size: 24rpx;
  line-height: 1.6;
}

.legal-links {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 24rpx;
  color: #172033;
  font-size: 24rpx;
  font-weight: 700;
}

.error-card {
  margin-top: 28rpx;
  border-radius: 28rpx;
  background: #fff1f2;
  padding: 24rpx;
  color: #9f1239;
  font-size: 26rpx;
}
