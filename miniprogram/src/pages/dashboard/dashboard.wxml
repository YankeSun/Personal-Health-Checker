<view class="page dashboard-page">
  <view class="hero card">
    <view class="hero-topline">
      <text class="eyebrow">OVERVIEW</text>
      <text class="date-label">{{dashboard.todayDate || "今日"}}</text>
    </view>
    <text class="hero-title">今日概览</text>
    <text class="hero-subtitle">已记录 {{dashboard.todayCompletedMetrics || 0}}/{{dashboard.totalTrackedMetrics || 3}} · 连续 {{dashboard.streakDays || 0}} 天</text>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{completionPercent}}%;"></view>
    </view>
  </view>

  <view class="action-stack">
    <view
      wx:for="{{actionCards}}"
      wx:key="id"
      class="action-card card {{item.toneClass}} {{item.isPrimary ? 'action-primary' : ''}}"
      data-route="{{item.route}}"
      bindtap="handleAction"
    >
      <text class="action-kicker">{{item.kicker}}</text>
      <text class="action-title">{{item.title}}</text>
      <text class="action-copy">{{item.description}}</text>
      <text class="action-link">{{item.actionLabel}}</text>
    </view>
  </view>

  <view class="grid">
    <view class="stat card">
      <text class="label">记录完成度</text>
      <text class="metric-value">{{window.completionRate || 0}}%</text>
      <text class="stat-note">近 {{window.days || 7}} 天</text>
    </view>
    <view class="stat card">
      <text class="label">目标达成</text>
      <text class="metric-value">{{windowAttainmentRate}}%</text>
      <text class="stat-note">已设目标</text>
    </view>
  </view>

  <view class="card weight-card">
    <view class="section-head">
      <text class="section-title">体重趋势</text>
      <text class="weight-badge">{{weightContext.recordedDays || 0}}/{{weightContext.days || 7}} 天</text>
    </view>
    <view class="weight-values">
      <view>
        <text class="label">最近体重</text>
        <text class="weight-value">{{weightContext.latestDisplay}}</text>
      </view>
      <view>
        <text class="label">近期变化</text>
        <text class="weight-value">{{weightContext.changeDisplay}}</text>
      </view>
    </view>
    <text class="context-title">{{weightContext.title}}</text>
    <text class="context-copy">{{weightContext.description}}</text>
    <view wx:if="{{weightContext.topContextLabels.length > 0}}" class="chips">
      <text wx:for="{{weightContext.topContextLabels}}" wx:key="label" class="chip">
        {{item.label}} {{item.count}} 次
      </text>
    </view>
  </view>

  <view class="card block">
    <text class="section-title">今日记录</text>
    <view wx:for="{{metricRows}}" wx:key="metric" class="metric-row">
      <view class="metric-main">
        <text class="metric-name">{{item.label}}</text>
        <text class="metric-detail">{{item.detailLabel}}</text>
      </view>
      <view class="metric-side">
        <text class="metric-display">{{item.valueLabel}}</text>
        <text class="metric-status {{item.statusClass}}">{{item.statusLabel}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{windowMetrics.length > 0}}" class="card block">
    <text class="section-title">近期记录</text>
    <view wx:for="{{windowMetrics}}" wx:key="metric" class="week-row">
      <text class="week-name">{{item.label}}</text>
      <text class="week-value">{{item.latestLabel}}</text>
      <text class="week-note">{{item.recordedLabel}}</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error-card">
    <text class="error">{{error}}</text>
    <text wx:if="{{errorDetail}}" class="error-detail">{{errorDetail}}</text>
    <button wx:if="{{errorRetryLabel}}" class="ghost-button retry-button" bindtap="retryLastAction">{{errorRetryLabel}}</button>
  </view>
</view>
