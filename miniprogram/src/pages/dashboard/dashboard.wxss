.hero {
  padding: 34rpx;
}

.eyebrow {
  color: #8a6a2d;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.title {
  display: block;
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 900;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.stat,
.block {
  padding: 30rpx;
}

.label {
  color: #6f675d;
  font-size: 24rpx;
  font-weight: 700;
}

.block {
  margin-top: 24rpx;
}

.metric-row,
.reminder {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
  padding: 24rpx 0;
  font-size: 28rpx;
}

.reminder {
  display: block;
}

.reminder-title {
  display: block;
  margin-bottom: 8rpx;
  font-weight: 800;
}

.empty,
.error {
  display: block;
  margin-top: 20rpx;
  color: #777064;
  font-size: 26rpx;
}

.error {
  color: #be123c;
}
