<view class="page">
  <view class="profile card">
    <text class="eyebrow">PROFILE</text>
    <text class="title">{{profile.displayName || "微信用户"}}</text>
    <text class="muted">体重单位 {{profile.weightUnit || "KG"}} · 饮水单位 {{profile.waterUnit || "ML"}}</text>
  </view>

  <view class="card block">
    <text class="section-title">目标</text>
    <view wx:if="{{goals.length === 0}}" class="empty">还没有配置目标，Web 设置页可继续完善。</view>
    <view wx:for="{{goals}}" wx:key="metric" class="goal-row">
      <text>{{item.metric}}</text>
      <text class="muted">{{item.isActive ? item.mode : "未启用"}}</text>
    </view>
  </view>

  <view class="card block beta-card">
    <text class="section-title">30 天体重观察报告</text>
    <text class="muted beta-copy">体重变化、目标进度和日常背景会整理成月度回看。当前仅记录内测意向，不收取费用。</text>
    <button class="primary-button action-button" loading="{{joiningReportBeta}}" bindtap="joinReportBeta">加入报告内测</button>
  </view>

  <view class="card block">
    <text class="section-title">Alpha 反馈</text>
    <text class="feedback-copy">这会帮助我们判断是否值得继续做小程序 beta。</text>
    <view class="rating-row">
      <text wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this" data-rating="{{item}}" bindtap="setFeedbackRating" class="rating-chip {{feedback.rating === item ? 'rating-active' : ''}}">{{item}}</text>
    </view>
    <text class="feedback-label">最有用的点</text>
    <view class="feedback-options">
      <text wx:for="{{feedbackValueOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="selectFeedbackValue" class="feedback-chip {{item.active ? 'feedback-chip-active' : ''}}">{{item.label}}</text>
    </view>
    <text class="feedback-label">最卡的点</text>
    <view class="feedback-options">
      <text wx:for="{{feedbackFrictionOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="selectFeedbackFriction" class="feedback-chip {{item.active ? 'feedback-chip-active' : ''}}">{{item.label}}</text>
    </view>
    <textarea class="feedback-textarea" value="{{feedback.comment}}" maxlength="160" bindinput="handleFeedbackComment" placeholder="一句话告诉我们：你会不会继续用？为什么？" />
    <button class="ghost-button action-button" loading="{{submittingFeedback}}" bindtap="submitFeedback">提交反馈</button>
  </view>

  <view class="card block">
    <text class="section-title">数据与账号</text>
    <button class="ghost-button action-button" loading="{{exporting}}" bindtap="exportAccount">导出个人数据</button>
    <button class="danger-button action-button" loading="{{deleting}}" bindtap="confirmDeleteAccount">删除账号和全部数据</button>
    <text wx:if="{{message}}" class="message">{{message}}</text>
  </view>

  <view class="card block">
    <text class="section-title">协议与说明</text>
    <view class="legal-list">
      <text data-type="privacy" bindtap="openLegal">隐私保护指引</text>
      <text data-type="terms" bindtap="openLegal">用户协议</text>
      <text data-type="health" bindtap="openLegal">健康免责声明</text>
    </view>
  </view>

  <button class="ghost-button logout-button" bindtap="logout">退出登录</button>
  <text wx:if="{{error}}" class="error">{{error}}</text>
</view>
