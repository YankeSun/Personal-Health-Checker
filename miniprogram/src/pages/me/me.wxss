.profile,
.block {
  padding: 34rpx;
}

.eyebrow {
  color: #8a6a2d;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.title {
  display: block;
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 900;
}

.block {
  margin-top: 24rpx;
}

.beta-card {
  background: #172033;
  color: #ffffff;
}

.beta-card .section-title,
.beta-card .muted {
  color: #ffffff;
}

.beta-copy {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.82;
}

.goal-row {
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
  padding: 24rpx 0;
  font-size: 28rpx;
}

.empty,
.error,
.message {
  display: block;
  margin-top: 22rpx;
  color: #777064;
  font-size: 26rpx;
}

.error {
  color: #be123c;
}

.message {
  color: #047857;
}

.action-button {
  margin-top: 22rpx;
}

.feedback-copy,
.feedback-label {
  display: block;
  margin-top: 18rpx;
  color: #777064;
  font-size: 26rpx;
  line-height: 1.6;
}

.feedback-label {
  color: #172033;
  font-weight: 800;
}

.rating-row,
.feedback-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.rating-chip,
.feedback-chip {
  border: 1rpx solid rgba(15, 23, 42, 0.14);
  border-radius: 999rpx;
  background: #ffffff;
  padding: 14rpx 22rpx;
  color: #5e574d;
  font-size: 24rpx;
}

.rating-active,
.feedback-chip-active {
  border-color: #172033;
  background: #172033;
  color: #ffffff;
}

.feedback-textarea {
  width: 100%;
  min-height: 160rpx;
  margin-top: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.12);
  border-radius: 24rpx;
  background: #f8fafc;
  padding: 22rpx;
  color: #172033;
  font-size: 26rpx;
  line-height: 1.6;
}

.legal-list {
  display: grid;
  gap: 18rpx;
  margin-top: 22rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.danger-button {
  background: #fff1f2;
  color: #be123c;
  font-size: 28rpx;
}

.logout-button {
  margin-top: 32rpx;
}
