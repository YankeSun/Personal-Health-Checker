.me-page {
  padding-bottom: 48rpx;
}

.profile,
.block {
  padding: 34rpx;
}

.profile {
  overflow: hidden;
  background:
    radial-gradient(circle at 86% 16%, rgba(247, 200, 111, 0.32), transparent 36%),
    linear-gradient(145deg, #172033 0%, #26372f 58%, #805f2c 100%);
  color: #fffaf0;
}

.profile-topline,
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.eyebrow {
  color: rgba(255, 250, 240, 0.72);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.eyebrow.light {
  color: rgba(255, 250, 240, 0.68);
}

.unit-pill {
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  color: rgba(255, 250, 240, 0.78);
  font-size: 22rpx;
}

.title {
  display: block;
  margin-top: 34rpx;
  font-size: 50rpx;
  font-weight: 950;
}

.profile-copy,
.beta-copy,
.feedback-copy,
.task-copy,
.data-copy,
.section-note {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
}

.profile-copy {
  margin-top: 12rpx;
  color: rgba(255, 250, 240, 0.78);
}

.block {
  margin-top: 24rpx;
}

.section-title {
  font-size: 30rpx;
}

.section-note {
  color: #777064;
}

.alpha-card {
  background: #fff8e8;
}

.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid rgba(95, 63, 26, 0.1);
  padding: 26rpx 0;
}

.task-main {
  flex: 1;
}

.task-title {
  display: block;
  color: #172033;
  font-size: 28rpx;
  font-weight: 950;
}

.task-copy {
  margin-top: 8rpx;
  color: #777064;
}

.task-action {
  border-radius: 999rpx;
  background: #172033;
  padding: 12rpx 18rpx;
  color: #fffaf0;
  font-size: 22rpx;
  font-weight: 900;
}

.beta-card {
  background: #172033;
  color: #fffaf0;
}

.beta-title {
  display: block;
  margin-top: 12rpx;
  color: #fffaf0;
  font-size: 38rpx;
  font-weight: 950;
}

.beta-copy {
  margin-top: 14rpx;
  color: rgba(255, 250, 240, 0.76);
}

.report-list {
  display: grid;
  gap: 12rpx;
  margin-top: 22rpx;
}

.report-item {
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 22rpx;
  padding: 14rpx 18rpx;
  color: rgba(255, 250, 240, 0.86);
  font-size: 24rpx;
}

.beta-button {
  min-height: 88rpx;
  margin-top: 26rpx;
  background: #f7c86f;
  color: #172033;
}

.feedback-card {
  border-color: rgba(23, 32, 51, 0.12);
}

.feedback-copy,
.data-copy {
  margin-top: 18rpx;
  color: #777064;
}

.feedback-label {
  display: block;
  margin-top: 22rpx;
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
}

.rating-row,
.feedback-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.rating-chip,
.feedback-chip {
  border: 1rpx solid rgba(15, 23, 42, 0.14);
  border-radius: 999rpx;
  background: #ffffff;
  padding: 14rpx 22rpx;
  color: #5e574d;
  font-size: 24rpx;
}

.rating-active,
.feedback-chip-active {
  border-color: #172033;
  background: #172033;
  color: #ffffff;
}

.feedback-textarea {
  width: 100%;
  min-height: 170rpx;
  margin-top: 22rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.12);
  border-radius: 24rpx;
  background: #f8f4ec;
  padding: 22rpx;
  color: #172033;
  font-size: 26rpx;
  line-height: 1.6;
}

.goal-row {
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
  padding: 24rpx 0;
  font-size: 28rpx;
}

.empty,
.error,
.message {
  display: block;
  margin-top: 22rpx;
  color: #777064;
  font-size: 26rpx;
}

.error-card {
  margin-top: 22rpx;
  border-radius: 28rpx;
  background: #fff1f2;
  padding: 22rpx;
}

.error {
  margin-top: 0;
  color: #be123c;
}

.error-detail {
  display: block;
  margin-top: 10rpx;
  color: #9f1239;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.message {
  color: #047857;
}

.retry-button {
  margin-top: 18rpx;
}

.action-button {
  margin-top: 22rpx;
}

.legal-list {
  display: grid;
  gap: 18rpx;
  margin-top: 22rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
}

.danger-button {
  background: #fff1f2;
  color: #be123c;
  font-size: 28rpx;
}

.logout-button {
  margin-top: 32rpx;
}
